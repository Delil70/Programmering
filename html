       var player = {x: 50, y: 200, size: 40, color: "blue" , speedX: 10, direction: 1, bounces: 0};
        var x = 0
       function update() {
        clearScreen()
    

        picture(x, 0, "https://shorturl.at/9F9lR", totalWidth * 2, totalHeight)
        x--
        text(50, 50, 40, "antal: " + player.bounces, "white")
        circle(player.x, player.y, player.size, player.color);
        player.x = player.x + player.speedX * player.direction
        
        // Studsa mot vänter kant - saknas!
        
        // om circkeln träffar höger kant, så ändras färdriktninig till vänster
        if(player.x + player.size > totalWidth) {
            player.direction = -1
            player.color = "red"
            player.size = 80
            player.bounces++
        }
            
        
        
           
        // Studsa mot vänster kant - saknas!
           

       // Studsa mot vänster kant saknas
       if(player.x - player.size < 0) {
         player.direction = 1
         player.color = "green"
         player.speedX = 60
        }
         

       }







